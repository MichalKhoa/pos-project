{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VoltFlow POS",
  "version": "0.1.0",
  "identifier": "com.voltflow.pos",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VoltFlow POS",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "VoltFlow POS"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/pos-backend"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "Czech"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3MEZBNjRBRERCMDk2OEEKUldTS2xyRGRTcVlQaHdKWTFkT1hYVFlUSU0vaFZFRWdzQ3gyeHplUGpOK0N3dStzdUlqRjFEWXAK",
      "endpoints": [
        "https://github.com/MichalKhoa/pos-project-himmel/releases/latest/download/latest.json"
      ]
    }
  }
}
