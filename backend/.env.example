# Himmel POS Environment Variables & Cloud Secrets
# COPY THIS FILE TO backend/.env AND FILL IN YOUR REAL VALUES.
# DO NOT COMMIT YOUR REAL backend/.env FILE TO GIT!

# Litestream S3 / Cloudflare R2 Cloud Backup Credentials
LITESTREAM_ACCESS_KEY_ID=your_access_key_here
LITESTREAM_SECRET_ACCESS_KEY=your_secret_access_key_here

# App Secret Key for Fernet Data Encryption (Auto-generated in .secret_key if missing)
APP_SECRET_KEY=

# Server Host & Network Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
